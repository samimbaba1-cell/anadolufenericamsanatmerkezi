# ============================================
# Frontend Production .env Hazırlık Dosyası
# ============================================
# Bu dosyayı production sunucuda frontend/.env.production olarak kopyalayın
# Tüm değerleri production için doldurun

# ============================================
# API Configuration
# ============================================
# Backend API URL'i
# Eğer backend ve frontend aynı sunucudaysa subdomain ile önerilen kullanım: https://api.anadolufenericamsanatmerkezi.com
# Not: Bu deger sadece origin olmali. Sonuna /api eklemeyin.
# Eğer backend ayrı subdomain'deyse: https://api.anadolufenericamsanatmerkezi.com
NEXT_PUBLIC_API_URL=

# ============================================
# Site URL (SEO için gerekli)
# ============================================
# Canlı site adresi (örn: https://anadolufenericamsanatmerkezi.com)
NEXT_PUBLIC_SITE_URL=

# ============================================
# Node Environment
# ============================================
NODE_ENV=production

# ============================================
# Google Analytics (Opsiyonel)
# ============================================
NEXT_PUBLIC_GA_ID=
