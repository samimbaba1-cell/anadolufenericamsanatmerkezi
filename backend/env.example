# ============================================
# Backend .env Örnek Dosyası
# ============================================
# Bu dosyayı backend/.env olarak kopyalayın ve production değerleriyle doldurun.

# Database
DATABASE_URL=mysql://db_user:db_password@localhost:3306/anadolufenericamsanatmerkezi
DB_HOST=localhost
DB_PORT=3306
DB_USER=db_user
DB_PASSWORD=change_me
DB_NAME=anadolufenericamsanatmerkezi

# Server
PORT=3000
NODE_ENV=development
# Mağaza kökü (HTTPS); pazaryeri API push sırasında göreli görsel URL'lerinin tam adresi için kullanılır.
FRONTEND_URL=http://localhost:3001
NEXT_PUBLIC_SITE_URL=http://localhost:3001
TRUST_PROXY=false
ADDITIONAL_ALLOWED_ORIGINS=

# JWT
JWT_SECRET=replace_with_a_random_64_char_secret
JWT_EXPIRE=7d
SETTINGS_SECRET_KEY=replace_with_a_different_random_64_char_secret

# Iyzico
IYZICO_API_KEY=
IYZICO_SECRET_KEY=
IYZICO_BASE_URL=https://sandbox-api.iyzipay.com

# Email
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM_EMAIL=
SMTP_FROM_NAME=Anadolu Feneri Cam Sanat Merkezi

# Upload
MAX_FILE_SIZE=10485760
UPLOAD_PATH=./uploads

# Security / rate limit
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Feed
FEED_TOKEN=replace_with_a_random_feed_token
FEED_VAT_DEFAULT=20
FEED_CURRENCY=TRY
FEED_DELIVERY_DAYS=3
FEED_IMAGE_LIMIT=10
FEED_BRAND_KEYS=brand,marka

# Marketplace webhook secrets
TRENDYOL_WEBHOOK_SECRET=
HEPSIBURADA_WEBHOOK_SECRET=
N11_WEBHOOK_SECRET=

# Logging
LOG_LEVEL=INFO

# Dangerous scripts - leave false in production unless you intentionally need one-time setup
# seedData: production'da her zaman yasak (sadece dev / Playwright)
ALLOW_PRODUCTION_SETUP=false
ALLOW_SCHEMA_SYNC=false
# Geliştirmede iPhone/Samsung gibi setup.js demolarını atlamak için: true
# SKIP_DEMO_DATA=true
