# Database
# REQUIRED: MongoDB connection string
# Example: mongodb+srv://username:password@cluster.mongodb.net/anadolufenericamsanatmerkezi?retryWrites=true&w=majority
# For local: mongodb://localhost:27017/anadolufenericamsanatmerkezi
DATABASE_URL=mongodb://localhost:27017/anadolufenericamsanatmerkezi

# Server
PORT=3000
NODE_ENV=development
FRONTEND_URL=http://localhost:3001

# JWT
# REQUIRED: Generate a strong random secret (at least 32 characters)
# Use: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
JWT_SECRET=CHANGE_THIS_TO_A_SECURE_RANDOM_STRING_AT_LEAST_32_CHARACTERS_LONG
JWT_EXPIRE=7d

# Settings Encryption
# REQUIRED: Used to encrypt sensitive configuration stored via admin panel (SMTP / Iyzico keys)
# Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SETTINGS_SECRET_KEY=CHANGE_THIS_TO_ANOTHER_SECURE_RANDOM_STRING

# Iyzico Payment
IYZICO_API_KEY=sandbox-your-api-key
IYZICO_SECRET_KEY=sandbox-your-secret-key

# Email (Nodemailer)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password

# File Upload (Cloudinary)
CLOUDINARY_CLOUD_NAME=your-cloud-name
CLOUDINARY_API_KEY=your-api-key
CLOUDINARY_API_SECRET=your-api-secret

# Google Analytics
GA_TRACKING_ID=G-XXXXXXXXXX

# Admin
ADMIN_EMAIL=admin@anadolufenericamsanatmerkezi.com
ADMIN_PASSWORD=admin123

# Security
BCRYPT_ROUNDS=12
RATE_LIMIT_WINDOW=900000
RATE_LIMIT_MAX=100

# Feed Configuration
FEED_TOKEN=YOUR_FEED_SECRET_TOKEN_HERE
FEED_VAT_DEFAULT=20
FEED_CURRENCY=TRY
FEED_DELIVERY_DAYS=3
FEED_IMAGE_LIMIT=10
FEED_BRAND_KEYS=brand,marka

# Webhook Secrets (Pazaryeri entegrasyonu)
TRENDYOL_WEBHOOK_SECRET=your_trendyol_webhook_secret
HEPSIBURADA_WEBHOOK_SECRET=your_hepsiburada_webhook_secret
N11_WEBHOOK_SECRET=your_n11_webhook_secret

# Logging
LOG_LEVEL=INFO
