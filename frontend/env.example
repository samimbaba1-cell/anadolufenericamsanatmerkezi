# ============================================
# Frontend .env Dosyası
# ============================================
# Local için: cp frontend/env.example frontend/.env.local
# Production için: cp frontend/env.example frontend/.env.production
# Sonra değerleri güncelleyin

# API Configuration
# Local: bos birak veya http://localhost:3000 | Production: https://api....
# Bos: tarayici /api/... cagirir; next.config rewrites (dev) istegi backend’e iletir.
# Dogrudan backend’e istek icin: NEXT_PUBLIC_API_URL=http://127.0.0.1:3000
# Not: Bu deger sadece origin olmali. Sonuna /api eklemeyin.
# NEXT_PUBLIC_API_URL=

# Telefon / LAN IP ile dev (ornek: http://192.168.1.20:3001). Bos: next.config icindeki varsayilanlar + bu liste.
# NEXT_ALLOWED_DEV_ORIGINS=http://192.168.1.20:3001,http://192.168.1.20:3000

# next dev: /api proxy hedefi (bos: ../backend/.env icindeki PORT kullanilir)
# NEXT_INTERNAL_BACKEND=http://127.0.0.1:3100

# Site URL (SEO için gerekli)
# Local: http://localhost:3001 | Production: https://anadolufenericamsanatmerkezi.com
NEXT_PUBLIC_SITE_URL=http://localhost:3001

# Node Environment
# Local: development | Production: production
NODE_ENV=development

# Google Analytics (Opsiyonel)
NEXT_PUBLIC_GA_ID=

